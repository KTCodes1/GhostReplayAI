{
  "name": "ghost-replay",
  "private": true,
  "version": "0.1.0",
  "description": "Ghost Replay \u2014 live synthetic match insights engine (Microsoft x Premier League hackathon)",
  "workspaces": [
    "engine",
    "server",
    "client"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "sim": "npm run sim -w @ghost/engine --",
    "dev": "concurrently -n server,client -c cyan,magenta \"npm run dev -w @ghost/server\" \"npm run dev -w @ghost/client\"",
    "validate": "npm run validate -w @ghost/engine",
    "build": "npm run build -w @ghost/client",
    "start": "npm start -w @ghost/server"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "concurrently": "^9.1.0"
  }
}
